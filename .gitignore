# Terraform downloaded providers and modules — never commit binaries
.terraform/

# Lock file: HCP Terraform manage its own provider versions; local lock
# causes version conflicts when the remote workspace uses a different OS/arch
.terraform.lock.hcl

# State files — state lives in HCP Terraform, never on disk
*.tfstate
*.tfstate.backup

# Crash and debug logs generated by the Terraform CLI
crash.log
crash.*.log

# Override files are for local experiments, not for the shared repo
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# .tfvars may contain secrets; values go in HCP Terraform workspace variables
*.tfvars
*.tfvars.json

# macOS metadata
.DS_Store
